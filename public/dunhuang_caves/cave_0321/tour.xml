 <hotspot name="h6x11p" url="b.png"  scale="0.5" ath="90.000" atv="-38.000" onclick="if(layer[n].visible,tween(layer[n].alpha,0);delayedcall(0.5,set(layer[n].visible,false)) ,set(layer[n].visible,true);tween(layer[n].alpha,1) )"  />
<layer name="n" url="image/yg.jpg" align="center"	   
onloaded="picture_resize(get(name));"  />
<action name="picture_resize">

<!-- 使用屏幕宽度或高度的百分之九十 -->

div(aspect, layer[%1].imagewidth, layer[%1].imageheight);

mul(new_width, stagewidth, 0.90);

div(new_height, new_width, aspect);

mul(max_height, stageheight, 0.90);

if(new_height GT max_height,

copy(new_height, max_height);

mul(new_width, new_height, aspect);

);

roundval(new_width);

roundval(new_height);

copy(layer[%1].width, new_width);

copy(layer[%1].height, new_height);

</action>
<events name="picture_period"  
onpreviewcomplete="set(layer[n].visible,false); tween(layer[n].alpha,1);delayedcall(10,tween(layer[n].alpha,0);delayedcall(0.5,set(layer[n].visible,false););));"/> 






